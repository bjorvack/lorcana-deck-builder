{
  "name": "lorcana-deck-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "lefthook install",
    "data:fetch": "tsx scripts/pipeline.ts --step fetch",
    "data:build": "tsx scripts/pipeline.ts --step build",
    "data:pipeline": "tsx scripts/pipeline.ts",
    "data:inkdecks": "tsx scripts/sources/inkdecks.ts",
    "data:dotgg": "tsx scripts/sources/dotgg.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "playwright-core": "^1.65.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
