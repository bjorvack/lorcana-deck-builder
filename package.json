{
  "name": "lorcana-deck-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/training/arena/tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "lefthook install",
    "data:fetch": "tsx scripts/pipeline.ts --step fetch",
    "data:build": "tsx scripts/pipeline.ts --step build",
    "data:pipeline": "tsx scripts/pipeline.ts",
    "data:inkdecks": "tsx scripts/sources/inkdecks.ts",
    "data:dotgg": "tsx scripts/sources/dotgg.ts",
    "arena:map": "tsx scripts/training/arena/map.ts",
    "arena:panel": "tsx scripts/training/arena/panel.ts",
    "arena:batch": "tsx scripts/training/arena/batch.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@discord/embedded-app-sdk": "file:scripts/training/vendor/stubs/@discord/embedded-app-sdk",
    "@logtape/logtape": "^2.4.2",
    "@logtape/pretty": "^2.4.2",
    "@tcg/bot-core": "file:scripts/training/vendor/bot-core",
    "@tcg/lorcana-cards": "file:scripts/training/vendor/lorcana-cards",
    "@tcg/lorcana-engine": "file:scripts/training/vendor/lorcana-engine",
    "@tcg/lorcana-types": "file:scripts/training/vendor/lorcana-types",
    "@tcg/protocol": "file:scripts/training/vendor/protocol",
    "@tcg/shared": "file:scripts/training/vendor/shared",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/seedrandom": "^3.0.8",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "mutative": "^1.1.0",
    "nanoid": "^5.0.0",
    "playwright-core": "^1.65.1",
    "seedrandom": "^3.0.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.3.5"
  }
}
