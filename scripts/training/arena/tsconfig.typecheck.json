{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Type resolution for the vendored packages goes through the hand-rolled
    // shims in types/ — the vendor's sources are authored for upstream's
    // toolchain and must never enter this program (see types/*.d.ts). tsx and
    // vitest ignore this file and resolve the real modules at runtime.
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@tcg/lorcana-engine": ["./types/lorcana-engine.d.ts"],
      "@tcg/lorcana-engine/*": ["./types/lorcana-engine-modules.d.ts"],
      "@tcg/lorcana-cards": ["./types/lorcana-cards.d.ts"],
      "@tcg/shared/*": ["./types/shared-modules.d.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "../generator/chunk-eval.ts",
    "../generator/deltas.ts",
    "../generator/deltas.test.ts",
    "../generator/restricted.ts",
    "../generator/restricted.test.ts",
    "../generator/coverage.ts",
    "../generator/coverage.test.ts",
    "../generator/slices.ts",
    "../generator/slices.test.ts"
  ],
  "exclude": ["../vendor", "../data", "types"]
}
