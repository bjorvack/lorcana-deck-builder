{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src", "scripts"],
  "exclude": [
    "scripts/training/vendor",
    "scripts/training/data",
    "scripts/training/arena",
    "scripts/training/generator/chunk-eval.ts",
    "scripts/training/generator/deltas.ts",
    "scripts/training/generator/deltas.test.ts",
    "scripts/training/generator/restricted.ts",
    "scripts/training/generator/restricted.test.ts",
    "scripts/training/generator/coverage.ts",
    "scripts/training/generator/coverage.test.ts",
    "scripts/training/generator/slices.ts",
    "scripts/training/generator/slices.test.ts",
    "scripts/training/export-winrate-opponents.ts"
  ]
}
